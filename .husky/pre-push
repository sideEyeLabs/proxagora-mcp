#!/bin/bash
# pre-push: CI mirror — catches failures before GitHub Actions

set -e

echo ""
echo "🔍 Pre-push CI check — running locally to catch failures early..."
echo ""

if [ -f "bun.lockb" ]; then PM="bun"
elif [ -f "pnpm-lock.yaml" ]; then PM="pnpm"
else PM="npm"; fi

# Step 1: Lint
echo "📋 Step 1/3: Lint..."
if $PM run lint 2>/dev/null; then
  echo "   ✅ Lint passed"
else
  echo "   ⚠️  No lint script — skipping"
fi

# Step 2: TypeScript
echo "🔷 Step 2/3: TypeScript..."
if [ -f "tsconfig.json" ]; then
  NODE_OPTIONS="--max-old-space-size=8192" npx tsc --noEmit
  echo "   ✅ TypeScript passed"
else
  echo "   ⚠️  No tsconfig.json — skipping"
fi

# Step 3: Tests
echo "🧪 Step 3/3: Tests..."
if $PM run test --if-present 2>/dev/null; then
  echo "   ✅ Tests passed"
else
  echo "   ⚠️  No tests configured — skipping"
fi

echo ""
echo "✅ All CI checks passed — safe to push!"
echo ""

